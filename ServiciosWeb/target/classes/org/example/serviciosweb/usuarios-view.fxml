<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" prefWidth="900" prefHeight="500"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.serviciosweb.controller.UsuarioController">

    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label text="Consulta de usuarios - API REST"
           style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button fx:id="btnConsultar" text="Consultar usuarios" onAction="#onConsultarUsuarios"/>
        <Label fx:id="lblEstado" text="Presione Consultar usuarios"/>
    </HBox>

    <TableView fx:id="tablaUsuarios" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="170"/>
            <TableColumn fx:id="colUsername" text="Username" prefWidth="120"/>
            <TableColumn fx:id="colCorreo" text="Correo" prefWidth="190"/>
            <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="140"/>
            <TableColumn fx:id="colCiudad" text="Ciudad" prefWidth="110"/>
            <TableColumn fx:id="colEmpresa" text="Empresa" prefWidth="120"/>
        </columns>
        <placeholder>
            <Label text="Tabla sin contenido"/>
        </placeholder>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

</VBox>
